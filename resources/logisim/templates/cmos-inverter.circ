<?xml version='1.0' encoding='utf-8'?>
<project source="2.7.1" version="1.0">
  <lib name="0" desc="#Wiring" />
  <lib name="1" desc="#Gates" />
  <lib name="2" desc="#Plexers" />
  <lib name="3" desc="#Arithmetic" />
  <lib name="4" desc="#Memory" />
  <lib name="5" desc="#I/O" />
  <lib name="6" desc="#Base" />
  <main name="main" />
  <options>
    <a name="gateUndefined" val="error" />
    <a name="simlimit" val="1000" />
    <a name="simrand" val="0" />
  </options>
  <mappings>
    <tool lib="6" name="Menu Tool" map="Button3" />
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool" />
    <tool lib="6" name="Edit Tool" />
    <tool lib="6" name="Text Tool" />
    <tool lib="0" name="Pin" />
    <tool lib="1" name="NOT Gate" />
    <tool lib="1" name="AND Gate" />
    <tool lib="1" name="OR Gate" />
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main" />
    <comp name="Transistor" loc="(250,170)" lib="0">
      <a name="type" val="p" />
      <a name="facing" val="south" />
      <a name="gate" val="tl" />
    </comp>
    <comp name="Transistor" loc="(250,230)" lib="0">
      <a name="type" val="n" />
      <a name="facing" val="north" />
      <a name="gate" val="tl" />
    </comp>
    <comp name="Power" loc="(250,100)" lib="0" />
    <comp name="Ground" loc="(250,300)" lib="0" />
    <wire from="(250,100)" to="(250,130)" />
    <wire from="(250,270)" to="(250,300)" />
    <wire from="(250,170)" to="(250,200)" />
    <wire from="(250,200)" to="(250,230)" />
    <wire from="(190,150)" to="(230,150)" />
    <wire from="(190,250)" to="(230,250)" />
    <wire from="(190,150)" to="(190,200)" />
    <wire from="(190,200)" to="(190,250)" />
    <comp name="Pin" loc="(100,200)" lib="0">
      <a name="label" val="A" />
      <a name="width" val="1" />
      <a name="tristate" val="false" />
    </comp>
    <wire from="(100,200)" to="(190,200)" />
    <comp name="Pin" loc="(390,200)" lib="0">
      <a name="label" val="Y" />
      <a name="width" val="1" />
      <a name="facing" val="west" />
      <a name="output" val="true" />
      <a name="labelloc" val="east" />
    </comp>
    <wire from="(250,200)" to="(390,200)" />
  </circuit>
</project>
