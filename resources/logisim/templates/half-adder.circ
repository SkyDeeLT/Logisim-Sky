<?xml version='1.0' encoding='utf-8'?>
<project source="2.7.1" version="1.0">
  <lib name="0" desc="#Wiring" />
  <lib name="1" desc="#Gates" />
  <lib name="2" desc="#Plexers" />
  <lib name="3" desc="#Arithmetic" />
  <lib name="4" desc="#Memory" />
  <lib name="5" desc="#I/O" />
  <lib name="6" desc="#Base" />
  <main name="main" />
  <options>
    <a name="gateUndefined" val="error" />
    <a name="simlimit" val="1000" />
    <a name="simrand" val="0" />
  </options>
  <mappings>
    <tool lib="6" name="Menu Tool" map="Button3" />
  </mappings>
  <toolbar>
    <tool lib="6" name="Poke Tool" />
    <tool lib="6" name="Edit Tool" />
    <tool lib="6" name="Text Tool" />
    <tool lib="0" name="Pin" />
    <tool lib="1" name="NOT Gate" />
    <tool lib="1" name="AND Gate" />
    <tool lib="1" name="OR Gate" />
  </toolbar>
  <circuit name="main">
    <a name="circuit" val="main" />
    <comp name="Pin" loc="(100,130)" lib="0">
      <a name="label" val="A" />
      <a name="width" val="1" />
      <a name="tristate" val="false" />
    </comp>
    <wire from="(100,130)" to="(120,130)" />
    <comp name="Tunnel" loc="(120,130)" lib="0">
      <a name="label" val="A" />
      <a name="facing" val="west" />
      <a name="width" val="1" />
    </comp>
    <comp name="Pin" loc="(100,190)" lib="0">
      <a name="label" val="B" />
      <a name="width" val="1" />
      <a name="tristate" val="false" />
    </comp>
    <wire from="(100,190)" to="(120,190)" />
    <comp name="Tunnel" loc="(120,190)" lib="0">
      <a name="label" val="B" />
      <a name="facing" val="west" />
      <a name="width" val="1" />
    </comp>
    <comp name="XOR Gate" loc="(290,130)" lib="1">
      <a name="size" val="30" />
      <a name="inputs" val="2" />
      <a name="width" val="1" />
    </comp>
    <comp name="Tunnel" loc="(220,120)" lib="0">
      <a name="label" val="A" />
      <a name="facing" val="east" />
      <a name="width" val="1" />
    </comp>
    <wire from="(220,120)" to="(250,120)" />
    <comp name="Tunnel" loc="(220,140)" lib="0">
      <a name="label" val="B" />
      <a name="facing" val="east" />
      <a name="width" val="1" />
    </comp>
    <wire from="(220,140)" to="(250,140)" />
    <comp name="Pin" loc="(390,130)" lib="0">
      <a name="label" val="Sum" />
      <a name="width" val="1" />
      <a name="facing" val="west" />
      <a name="output" val="true" />
      <a name="labelloc" val="east" />
    </comp>
    <wire from="(290,130)" to="(390,130)" />
    <comp name="AND Gate" loc="(290,190)" lib="1">
      <a name="size" val="30" />
      <a name="inputs" val="2" />
      <a name="width" val="1" />
    </comp>
    <comp name="Tunnel" loc="(230,180)" lib="0">
      <a name="label" val="A" />
      <a name="facing" val="east" />
      <a name="width" val="1" />
    </comp>
    <wire from="(230,180)" to="(260,180)" />
    <comp name="Tunnel" loc="(230,200)" lib="0">
      <a name="label" val="B" />
      <a name="facing" val="east" />
      <a name="width" val="1" />
    </comp>
    <wire from="(230,200)" to="(260,200)" />
    <comp name="Pin" loc="(390,190)" lib="0">
      <a name="label" val="Cout" />
      <a name="width" val="1" />
      <a name="facing" val="west" />
      <a name="output" val="true" />
      <a name="labelloc" val="east" />
    </comp>
    <wire from="(290,190)" to="(390,190)" />
  </circuit>
</project>
