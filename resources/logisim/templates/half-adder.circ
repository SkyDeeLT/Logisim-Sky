    <wire from="(250,150)" to="(250,140)" />
    <wire from="(250,140)" to="(270,140)" />
    <comp name="Pin" loc="(410,130)" lib="0">
      <a name="label" val="Sum" />
      <a name="width" val="1" />
      <a name="facing" val="west" />
      <a name="output" val="true" />
      <a name="labelloc" val="east" />
    </comp>
    <wire from="(310,130)" to="(410,130)" />
    <comp name="AND Gate" loc="(310,210)" lib="1">
      <a name="size" val="30" />
      <a name="inputs" val="2" />
      <a name="width" val="1" />
